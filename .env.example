# Copy to .env and .env.local and fill in.

# Postgres connection string. Recommended providers: Neon, Supabase, Railway.
DATABASE_URL="postgresql://user:password@localhost:5432/peos?schema=public"

# --- Auth.js -------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth client — Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI in dev: http://localhost:3000/api/auth/callback/google
# Required scopes on the consent screen:
#   openid, .../auth/userinfo.email, .../auth/userinfo.profile,
#   .../auth/calendar.readonly
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth app — register at https://github.com/settings/developers
# Authorization callback URL in dev: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Cron (Phase 6) ------------------------------------------------------
# Bearer token Vercel Cron sends with scheduled requests. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Locally, hit endpoints with:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/sync-calendars
CRON_SECRET=""
