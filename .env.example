# Copy to .env and .env.local and fill in.

# Postgres connection string. Recommended providers: Neon, Supabase, Railway.
DATABASE_URL="postgresql://user:password@localhost:5432/peos?schema=public"

# --- Auth.js -------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Microsoft Entra ID app — register at https://entra.microsoft.com
# Redirect URI in dev: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# GitHub OAuth app — register at https://github.com/settings/developers
# Authorization callback URL in dev: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
