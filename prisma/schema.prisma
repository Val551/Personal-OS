// Personal Engineering OS — database schema
// Translated from lib/types.ts. See docs/development/migration-to-real-data.md
// for context.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// User + Auth.js (NextAuth v5) tables
// =====================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? // Auth.js convention
  timezone      String?   // e.g. "America/New_York" (Phase 6)
  lastCalendarSyncAt DateTime? // last successful Google Calendar sync (Phase 6)
  lastPRSyncAt       DateTime? // last successful GitHub PR sync (Phase 6)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // App relations
  tasks        Task[]
  meetings     Meeting[]
  notes        Note[]
  pullRequests PullRequest[]
  recaps       Recap[]
}

// Auth.js standard schema. See: https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================================
// Task
// =====================================================================

enum Workspace {
  internship
  school
  personal
  club
}

enum Priority {
  low
  med
  high
  urgent
}

enum TaskStatus {
  todo
  doing
  blocked
  done
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  title       String
  notes       String?
  workspace   Workspace
  priority    Priority
  status      TaskStatus
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedMeetingId String?
  linkedMeeting   Meeting? @relation(fields: [linkedMeetingId], references: [id], onDelete: SetNull)
  linkedNotes     Note[]   @relation("TaskNotes")

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, workspace])
  @@index([linkedMeetingId])
}

// =====================================================================
// Meeting
// =====================================================================

model Meeting {
  id          String    @id @default(cuid())
  userId      String
  title       String
  startAt     DateTime
  endAt       DateTime
  location    String?
  attendees   String[]
  description String?
  workspace   Workspace
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Calendar sync (Phase 4)
  externalId        String? // Google Calendar event id
  calendarSyncToken String? // nextSyncToken for incremental sync (Phase 4 V2)

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]
  tasks Task[]

  @@unique([userId, externalId])
  @@index([userId, startAt])
}

// =====================================================================
// Note
// =====================================================================

enum NoteType {
  worklog
  general
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      NoteType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedMeetingId String?
  linkedMeeting   Meeting? @relation(fields: [linkedMeetingId], references: [id], onDelete: SetNull)
  linkedTasks     Task[]   @relation("TaskNotes")

  @@index([userId, type])
  @@index([userId, updatedAt])
  @@index([linkedMeetingId])
}

// =====================================================================
// PullRequest
// =====================================================================

enum PRState {
  open
  draft
  merged
  closed
}

enum PRBucket {
  authored
  review_requested
  assigned
  stale
}

enum CIStatus {
  passing
  failing
  pending
  none
}

// Note: createdAt / updatedAt on this model are GitHub's timestamps
// (synced from the API), NOT row creation/update times. lastSyncedAt
// tracks when we last refreshed the row locally.
model PullRequest {
  id           String   @id @default(cuid())
  userId       String
  externalId   String? // GitHub global node id (Phase 5)
  number       Int
  repo         String
  title        String
  state        PRState
  bucket       PRBucket
  author       String
  reviewers    String[]
  htmlUrl      String
  additions    Int
  deletions    Int
  comments     Int
  ciStatus     CIStatus
  createdAt    DateTime // GitHub's createdAt
  updatedAt    DateTime // GitHub's updatedAt
  lastSyncedAt DateTime @default(now()) @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@unique([userId, repo, number])
  @@index([userId, bucket])
  @@index([userId, updatedAt])
}

// =====================================================================
// Recap
// =====================================================================

// One recap per user per day. `date` is yyyy-MM-dd in the user's local tz.
model Recap {
  id              String   @id @default(cuid())
  userId          String
  date            String   // yyyy-MM-dd
  accomplishments String
  blockers        String
  topThree        String
  carryOver       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}
